{
  "_about": "Everything PocketTool needs to work without the internet. 'npm run fetch' downloads these exact files, the same ones the browser version loads, into the offline folder.",
  "cdn": [
    { "package": "pdfjs-dist", "version": "3.11.174", "include": ["^/build/pdf\\.min\\.js$", "^/build/pdf\\.worker\\.min\\.js$"] },
    { "package": "pdf-lib", "version": "1.17.1", "include": ["^/dist/pdf-lib\\.min\\.js$"] },
    { "package": "jszip", "version": "3.10.1", "include": ["^/dist/jszip\\.min\\.js$"] },
    { "package": "heic2any", "version": "0.0.4", "include": ["^/dist/heic2any\\.min\\.js$"] },
    { "package": "@tensorflow/tfjs", "version": "4.22.0", "include": ["^/dist/tf\\.min\\.js$"] },
    { "package": "upscaler", "version": "1.0.0-beta.19", "include": ["^/dist/browser/umd/"] },
    { "package": "@upscalerjs/esrgan-slim", "version": "1.0.0", "include": ["^/dist/umd/", "^/models/"], "optional": true, "group": "upscaler-model" },
    { "package": "@upscalerjs/esrgan-slim", "version": "1.0.0-beta.12", "include": ["^/dist/umd/", "^/models/"], "optional": true, "group": "upscaler-model" },
    { "package": "@huggingface/transformers", "version": "3.5.1", "include": ["^/dist/"], "exclude": ["\\.map$", "\\.cjs$", "node", "\\.d\\.ts$"] },
    { "package": "onnxruntime-web", "versionFrom": "@huggingface/transformers@3.5.1", "include": ["^/dist/[^/]+\\.(wasm|mjs)$"], "optional": true }
  ],
  "models": [
    { "repo": "briaai/RMBG-1.4", "about": "Remove background, Anything mode (free for non-commercial use)",
      "files": ["onnx/model.onnx", "onnx/model_quantized.onnx"], "optional": ["config.json", "preprocessor_config.json"] },
    { "repo": "Xenova/modnet", "about": "Remove background, People mode (Apache 2.0)",
      "files": ["onnx/model.onnx"], "optional": ["config.json", "preprocessor_config.json", "onnx/model_quantized.onnx"] }
  ],
  "fontsFrom": "app/index.html",
  "snapshots": [
    { "url": "https://www.gov.uk/bank-holidays.json", "to": "govuk/bank-holidays.json" }
  ]
}
