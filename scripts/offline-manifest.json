{
  "_about": "Everything PocketTool needs to work without the internet. 'npm run fetch' downloads these exact files, the same ones the browser version loads, into the offline folder.",
  "cdn": [
    {
      "package": "pdfjs-dist",
      "version": "3.11.174",
      "include": [
        "^/build/pdf\\.min\\.js$",
        "^/build/pdf\\.worker\\.min\\.js$"
      ]
    },
    {
      "package": "pdf-lib",
      "version": "1.17.1",
      "include": [
        "^/dist/pdf-lib\\.min\\.js$"
      ]
    },
    {
      "package": "jszip",
      "version": "3.10.1",
      "include": [
        "^/dist/jszip\\.min\\.js$"
      ]
    },
    {
      "package": "heic2any",
      "version": "0.0.4",
      "include": [
        "^/dist/heic2any\\.min\\.js$"
      ]
    },
    {
      "package": "@tensorflow/tfjs",
      "version": "4.22.0",
      "include": [
        "^/dist/tf\\.min\\.js$"
      ]
    },
    {
      "package": "upscaler",
      "version": "1.0.0-beta.19",
      "include": [
        "^/dist/browser/umd/"
      ]
    },
    {
      "package": "@upscalerjs/esrgan-slim",
      "version": "1.0.0",
      "include": [
        "^/dist/umd/",
        "^/models/"
      ],
      "optional": true,
      "group": "upscaler-model"
    },
    {
      "package": "@upscalerjs/esrgan-slim",
      "version": "1.0.0-beta.12",
      "include": [
        "^/dist/umd/",
        "^/models/"
      ],
      "optional": true,
      "group": "upscaler-model"
    },
    {
      "package": "@huggingface/transformers",
      "version": "3.5.1",
      "include": [
        "^/dist/"
      ],
      "exclude": [
        "\\.map$",
        "\\.cjs$",
        "node",
        "\\.d\\.ts$",
        "^(?!.*jsep).*\\.wasm$"
      ]
    },
    {
      "package": "@ffmpeg/ffmpeg",
      "version": "0.12.10",
      "include": [
        "^/dist/umd/ffmpeg\\.js$",
        "^/dist/umd/814\\.ffmpeg\\.js$"
      ]
    },
    {
      "package": "@ffmpeg/core",
      "version": "0.12.6",
      "include": [
        "^/dist/esm/ffmpeg-core\\.(js|wasm)$"
      ]
    }
  ],
  "models": [
    {
      "repo": "wonfy/BiRefNet-ONNX-webgpu",
      "revision": "041c6b25157431ac09634955246726ea2614fd0f",
      "about": "Remove background, Best quality (BiRefNet, MIT; needs a graphics card)",
      "files": [
        "onnx/model_fp16.onnx"
      ],
      "optional": [
        "config.json",
        "preprocessor_config.json"
      ]
    },
    {
      "repo": "wonfy/BiRefNet_lite-ONNX-webgpu",
      "revision": "c40eaa22fb1af9edcf75c7b79d25ed8a8e901140",
      "about": "Remove background, Standard (BiRefNet Lite, MIT; graphics card and processor versions)",
      "files": [
        "onnx/model_fp16.onnx",
        "onnx/model.onnx"
      ],
      "optional": [
        "config.json",
        "preprocessor_config.json"
      ]
    },
    {
      "repo": "Xenova/modnet",
      "about": "Remove background, People quick (MODNet, Apache 2.0)",
      "files": [
        "onnx/model.onnx"
      ],
      "optional": [
        "config.json",
        "preprocessor_config.json"
      ]
    }
  ],
  "fontsFrom": "app/index.html",
  "snapshots": [
    {
      "url": "https://www.gov.uk/bank-holidays.json",
      "to": "govuk/bank-holidays.json"
    }
  ]
}